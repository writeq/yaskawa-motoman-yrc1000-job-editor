{
  "name": "yrc1000-job-editor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Free, open-source desktop job editor for Yaskawa Motoman YRC1000 robot controllers, built with Electron, React, and TypeScript.",
  "keywords": [
    "yaskawa",
    "motoman",
    "yrc1000",
    "robot",
    "job-editor",
    "electron",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/writeq/yaskawa-motoman-yrc1000-job-editor.git"
  },
  "bugs": {
    "url": "https://github.com/writeq/yaskawa-motoman-yrc1000-job-editor/issues"
  },
  "homepage": "https://github.com/writeq/yaskawa-motoman-yrc1000-job-editor#readme",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "build": {
    "appId": "com.jobeditor.yrc1000",
    "productName": "YRC1000 Job Editor",
    "icon": "build-resources/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
